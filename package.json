{
  "name": "esg-mining-intelligence-system",
  "version": "0.1.0",
  "private": true,
  "description": "Backend MVP for the ESG Mining Intelligence System.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "psql \"$DATABASE_URL\" -f db/001_initial_schema.sql"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "fastify": "latest",
    "pg": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
